class Solution{
    Node mergeTwoList(Node a,Node b){
        Node temp=new Node(0);
        Node res=temp;
        
        while(a!=null && b!=null){
            if(a.data<b.data){
                temp.bottom=a;
                temp=temp.bottom;
                a=a.bottom;
                
            }
            else{
                temp.bottom=b;
                temp=temp.bottom;
                b=b.bottom;
            }
        }
        if(a!=null) temp.bottom=a;
        else temp.bottom=b;
        return res.bottom;
        
    }

    public Node flatten(Node root) {
        if(root==null || root.next==null)
          return root;

        //recursion for List on right
        root.next=flatten(root.next);

        //merge Two List
        root=mergeTwoList(root,root.next);

        ///retrun the root
        //it will be in turn merged with its left
        return root;
    }

}
